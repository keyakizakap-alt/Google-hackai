# ---- OshiReady 環境変数（Cloud Run では Secret Manager 経由で注入） ----
APP_BASE_URL=http://localhost:3000
# Cookie 暗号化・プラン署名用（32 文字以上のランダム文字列）
SESSION_SECRET=

# Google OAuth（Calendar API: calendar.events.readonly）。未設定ならデモカレンダーで動作
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini: どちらか一方を設定。未設定ならルールベースで動作
# (A) Gemini Enterprise Agent Platform（旧 Vertex AI）経由【推奨・Cloud Run はサービスアカウントの ADC で認証】
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# (B) Gemini API キー
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AGENT_MAX_STEPS=10

# 駅すぱあと API MCP サーバー。未設定なら経路はモック
EKISPERT_API_KEY=
EKISPERT_MCP_URL=https://api-mcp.ekispert.jp/mcp

# YouCam API（現状はモック実装。キーを設定してもモックで動作）
YOUCAM_API_KEY=
