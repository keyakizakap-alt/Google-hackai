# ---- OshiReady 環境変数（Cloud Run では Secret Manager 経由で注入） ----
APP_BASE_URL=http://localhost:3000
# Cookie 暗号化・プラン署名用（32 文字以上のランダム文字列）
SESSION_SECRET=

# 入れ替え前の古い SESSION_SECRET（任意・カンマ区切り）。入れ替え手順は docs/operations.md
SESSION_SECRET_PREVIOUS=

# 有効にするカレンダー連携先（カンマ区切り）。連携先の追加方法は docs/calendar-sources.md
CALENDAR_SOURCES=google,sample

# アプリ内予約に使う部品（カンマ区切り）。既定 demo（デモ予約：実在の店舗には届かない）。
# 空にするとアプリ内予約をやめ、予約サイトへの案内だけにする。部品の追加方法は src/lib/booking/types.ts
BOOKING_PROVIDERS=demo

# デモのカレンダー（任意）。実行サービスアカウントに共有したデモ専用カレンダーの ID。
# 設定すると「デモのカレンダーで試す」ボタンが出る（ログイン不要）。手順は docs/demo-calendar.md
DEMO_CALENDAR_ID=

# Google OAuth（Calendar API: calendar.events.readonly）。未設定なら連携なし（スクショ・文章・手入力で登録）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini: どちらか一方を設定。未設定ならルールベースで動作
# (A) Gemini Enterprise Agent Platform（旧 Vertex AI）経由【推奨・Cloud Run はサービスアカウントの ADC で認証】
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# (B) Gemini API キー
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 予備のモデル（任意）。メインが混雑・障害・提供終了で使えないときだけ使う（例: Flash-Lite）。モデル名は公式ドキュメントで確認する
GEMINI_FALLBACK_MODEL=
AGENT_MAX_STEPS=12

# 駅すぱあと API MCP サーバー。未設定なら経路はモック
EKISPERT_API_KEY=
EKISPERT_MCP_URL=https://api-mcp.ekispert.jp/mcp

# YouCam API（現状はモック実装。キーを設定してもモックで動作）
YOUCAM_API_KEY=

# 安全・コスト関連（任意）
# AI 呼び出しの 1 日あたり上限（インスタンス単位）
AGENT_DAILY_LIMIT=500
# Cloud Run 等で外部ロードバランサー経由なら 2（利用者 IP の取り出し位置）
TRUSTED_PROXY_HOPS=1
# AI に使わせる駅すぱあとのツール名（カンマ区切り）。未設定なら検索系のみ自動許可
EKISPERT_ALLOWED_TOOLS=
