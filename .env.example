# Gemini API キー。未設定でもデモモードで動作する（ルールベースにフォールバック）
GEMINI_API_KEY=

# 使用モデル。gemini-2.5-flash は提供終了済みのため使わないこと
GEMINI_MODEL=gemini-3.5-flash

# デモ時に時刻を固定したい場合に指定（0-23）。営業時間フィルタの検証にも使う
# DEMO_HOUR=14

# --- スポットの供給元 ---
# static (既定) … backend/catalog.py の静的カタログ
# places        … Google Places API。取得失敗時は static に自動退避する
SPOT_SOURCE=static

# Places API (New) のキー。SPOT_SOURCE=places のときに必須
PLACES_API_KEY=

# editorialSummary を取得するか。0 にすると Atmosphere SKU を避けて1段安くなる
# PLACES_USE_SUMMARY=1
# PLACES_CACHE_TTL_SEC=3600
# PLACES_RADIUS_M=1500
